     "type": "string"
    }
   },
   "type": "object"
  },
  "wiki_chunks": {
   "required": [
    "id",
    "pillar",
    "embedding",
    "created_at"
   ],
   "properties": {
    "id": {
     "default": "gen_random_uuid()",
     "description": "Note:\nThis is a Primary Key.<pk/>",
     "format": "uuid",
     "type": "string"
    },
    "pillar": {
     "format": "text",
     "type": "string"
    },
    "content_type": {
     "format": "text",
     "type": "string"
    },
    "title": {
     "format": "text",
     "type": "string"
    },
    "author": {
     "format": "text",
     "type": "string"
    },
    "key_frameworks": {
     "format": "text",
     "type": "string"
    },
    "embedding": {
     "format": "public.halfvec(1536)",
     "type": "string"
    },
    "created_at": {
     "default": "now()",
     "format": "timestamp with time zone",
     "type": "string"
    },
    "chunk_index": {
     "format": "int32",
     "type": "integer"
    },
    "source_id": {
     "description": "Note:\nThis is a Foreign Key to `wiki_sources.id`.<fk table='wiki_sources' column='id'/>",
     "format": "uuid",
     "type": "string"
    }
   },
   "type": "object"
  },
  "user_concept_states": {
   "required": [
    "id",
    "user_id",
    "concept_id",
    "state",
    "updated_at"
   ],
   "properties": {
    "id": {
     "default": "gen_random_uuid()",
     "description": "Note:\nThis is a Primary Key.<pk/>",
     "format": "uuid",
     "type": "string"
    },
    "user_id": {
     "format": "uuid",
     "type": "string"
    },
    "concept_id": {
     "description": "Note:\nThis is a Foreign Key to `source_learning_maps.id`.<fk table='source_learning_maps' column='id'/>",
     "format": "uuid",
     "type": "string"
    },
    "state": {
     "default": "encountered",
     "enum": [
      "encountered",
      "partial",
      "absorbed"
     ],
     "format": "public.concept_learning_state",
     "type": "string"
    },
    "updated_at": {
     "default": "now()",
     "format": "timestamp with time zone",
     "type": "string"
    }
   },
   "type": "object"
  }
 },
 "rpc": [
  "/rpc/match_wiki_chunks"
 ]
}