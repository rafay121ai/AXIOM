# Required. Set to your Vercel deployment URL in production.
# Example: https://axiom.vercel.app
FRONTEND_URL=http://localhost:5173

# Supabase — get these from your project's API settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Knowledge Supabase project used only for canonical wiki/RAG retrieval.
VITE_KNOWLEDGE_SUPABASE_URL=https://your-knowledge-project.supabase.co
VITE_KNOWLEDGE_SUPABASE_ANON_KEY=your-knowledge-anon-key
KNOWLEDGE_SUPABASE_SERVICE_ROLE_KEY=your-knowledge-service-role-key

# Server-side only. Never prefix with VITE_.
OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-5.4-mini-2026-03-17.
# OPENAI_LEARNING_MAP_MODEL=gpt-5.4-mini-2026-03-17
EXA_API_KEY=your-exa-key

# Optional live-search controls. Defaults: 6h cache, max 5 results.
# LIVE_SEARCH_CACHE_TTL_MS=21600000
# LIVE_SEARCH_MAX_RESULTS=5

# API server base URL — used by the frontend to reach the Express server
VITE_API_URL=http://localhost:3001
